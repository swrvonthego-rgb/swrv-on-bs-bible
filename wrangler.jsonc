{
  "name": "swrv-on-bs-bible",
  "main": "worker.js",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
  // D1 replaces Supabase for auth + notes/bookmarks/reading_progress.
  // IMPORTANT: `wrangler deploy` validates every declared binding's id at
  // deploy time and refuses to publish ANYTHING if a d1_databases entry's
  // database_id isn't a real, existing database — a placeholder string here
  // breaks every future deploy, not just the D1 feature. So this binding
  // stays fully absent until `wrangler d1 create swrv-bible-db` has run once
  // and produced a real id. Add this block back in then, with that real id:
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "swrv-bible-db", "database_id": "<real-id-here>" }
  // ]
  //
  // Until it's added, env.DB is undefined and every /api/auth, /api/notes,
  // /api/bookmarks, /api/progress, /api/delete-account route safely responds
  // 501 "not configured yet" instead of crashing (see worker.js).
}
