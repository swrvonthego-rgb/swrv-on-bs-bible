{
  "name": "swrv-on-bs-bible",
  "main": "worker.js",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Large library texts (Book of Jubilees) and the full BSB audio Bible
  // (recorded chapter audio + per-verse timing data) are served from R2
  // instead of bundled as static assets — the Worker intercepts their
  // request paths and streams from this bucket (see worker.js). The
  // deploy workflow keeps the bucket in sync on every push (see
  // .github/workflows/deploy.yml), so git stays the source of truth and
  // R2 is purely how it's served.
  "r2_buckets": [
    { "binding": "LIBRARY_BUCKET", "bucket_name": "swrv-bible-library" }
  ],
  // D1 replaces Supabase for auth + notes/bookmarks/reading_progress.
  // Real database, created via the Cloudflare D1 API (name: swrv-bible-db).
  // deploy.yml's "Apply D1 schema" step runs schema.sql against this on
  // every push — every statement there is CREATE TABLE/INDEX IF NOT
  // EXISTS, so that's a safe no-op once the tables already exist.
  "d1_databases": [
    { "binding": "DB", "database_name": "swrv-bible-db", "database_id": "4f4be675-aab0-49b4-a520-9bb0158c287e" }
  ]
}
