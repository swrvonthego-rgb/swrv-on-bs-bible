dictionary-coverage-report.json

# Build output (if you add a bundler later)
dist/
build/

# Local env / secrets — NEVER commit
.env
.env.*
*.pem
*.key
secrets.json

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
.claude/
